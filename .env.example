# ============================================
# RateCard Agentic Workflow - Environment Config
# ============================================

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
MOCK_MODE=true

# PostgreSQL
DATABASE_URL=postgresql://ratecard:ratecard_pass@localhost:5432/ratecard_workflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ratecard_workflow
DB_USER=ratecard
DB_PASSWORD=ratecard_pass

# Email Service (stub mode by default)
EMAIL_PROVIDER=stub
SENDGRID_API_KEY=your_sendgrid_key_here
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret

# RateCube API (stub mode by default)
RATECUBE_API_URL=https://api.ratecube.example.com
RATECUBE_API_KEY=your_ratecube_key_here
RATECUBE_MOCK=true

# Workflow Settings
MAX_REVISION_CYCLES=3
APPROVAL_DEADLINE_DAYS=7
MONITORING_INTERVAL_HOURS=4
ESCALATION_EMAIL=manager@company.com

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/workflow.log
